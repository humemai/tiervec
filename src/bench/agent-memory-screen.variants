# The variants of the screen preset of the agent-memory benchmark, one per line: name arm key=value ...
# (docs/AGENT-MEMORY-BENCHMARK.md, "The screen"). An idea of docs/SCREEN-IDEAS.md adds its variants here.
exact exact
tier tier
tier-insert tier mergeMode=INSERT
# one graph segment that every seal merges into: the layout where each merge takes the largest segment (idea S2)
tier-m1 tier maxSegments=1
tier-m1-insert tier maxSegments=1 mergeMode=INSERT
graph-a10 graph graph.alpha=1.0
graph-a12 graph graph.alpha=1.2
# JVector's graph, updated in place (issue #160): at the alpha of 1.2 of its tuning page, and at 1.0. Needs the jars of the profile bench
jvector jvector
jvector-a10 jvector alpha=1.0
